generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationPath {
  new_professional
  current_trainer
}

enum ApplicationStatus {
  submitted
  booked
  reviewed
  advanced
  declined
}

enum ApplicantStage {
  new_no_account
  has_accounts_no_time
  working_no_progress
}

enum BookingStatus {
  confirmed
  cancelled
}

enum PipelineStage {
  NEW
  REVIEWING
  CONTACTED
  DEMO_SCHEDULED
  QUALIFIED
  ONBOARDING
  REJECTED
  ARCHIVED
}

enum ActivityType {
  submitted
  stage_changed
  assignee_changed
  note_added
  tag_changed
  demo_scheduled
  demo_updated
  archived
  rejected
  bulk_updated
}

enum OpportunityStatus {
  open
  closed
}

enum AccountActivityType {
  account_created
  profile_updated
  opportunity_saved
  intro_call_booked
  application_linked
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  passwordHash         String
  emailVerifiedAt      DateTime?
  emailVerifyTokenHash String?
  emailVerifyExpiresAt DateTime?
  resetTokenHash       String?
  resetExpiresAt       DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sessions             UserSession[]
  profile              Profile?
  applications         Application[]
  savedOpportunities   SavedOpportunity[]
  activities           AccountActivity[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Profile {
  id                      String          @id @default(cuid())
  userId                  String          @unique
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName               String          @default("")
  lastName                String          @default("")
  phone                   String?
  city                    String?
  state                   String?
  profession              String?
  timezone                String?
  applicantStage          ApplicantStage?
  yearsOfAiTraining       Int             @default(0)
  usEligibilityConfirmed  Boolean         @default(false)
  yearsDomainExperience   Int?
  specialties             String[]        @default([])
  skills                  String[]        @default([])
  educationLevel          String?
  desiredCategories       String[]        @default([])
  weeklyAvailability      String?
  platformsJoined         String[]        @default([])
  platformStatus          String?
  remotePreference        String?
  languages               String[]        @default([])
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

model Opportunity {
  id                    String              @id @default(cuid())
  sourcePlatform        String
  sourceUrl             String
  externalId            String?
  title                 String
  summary               String
  category              String
  skills                String[]            @default([])
  experienceRequirement String?
  location              String?
  remoteStatus          String?
  compensationText      String?
  beginnerFriendly      Boolean             @default(false)
  eligibility           String?
  postedAt              DateTime?
  firstSeenAt           DateTime            @default(now())
  lastVerifiedAt        DateTime            @default(now())
  status                OpportunityStatus   @default(open)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  savedBy               SavedOpportunity[]

  @@index([status, createdAt])
  @@index([sourcePlatform])
  @@index([category])
}

model SavedOpportunity {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId  String
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, opportunityId])
  @@index([userId, createdAt])
}

model AccountActivity {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AccountActivityType
  message   String
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
}

model Application {
  id                     String            @id @default(cuid())
  userId                 String?
  user                   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName              String
  lastName               String
  fullName               String
  email                  String
  phone                  String
  city                   String
  state                  String
  profession             String
  yearsOfExperience      Int
  location               String?
  timezone               String
  path                   ApplicationPath   @default(new_professional)
  linkedinUrl            String?
  background             String            @default("")
  goals                  String            @default("")
  ipAddress              String?
  ipLocation             String?
  applicantStage         ApplicantStage?
  referralSource         String?
  usEligibilityConfirmed Boolean           @default(false)
  status                 ApplicationStatus @default(submitted)
  pipelineStage          PipelineStage     @default(NEW)
  assignee               String?
  tags                   String[]          @default([])
  nextActionAt           DateTime?
  demoScheduledAt        DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  bookings               Booking[]
  notes                  ApplicationNote[]
  activities             ApplicationActivity[]

  @@index([email])
  @@index([userId])
  @@index([status])
  @@index([pipelineStage])
  @@index([assignee])
  @@index([createdAt])
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        String
  body          String
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}

model ApplicationActivity {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ActivityType
  actor         String
  message       String
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([applicationId, createdAt])
}

model AvailabilityRule {
  id            String   @id @default(cuid())
  weekday       Int
  startTime     String
  endTime       String
  timezone      String
  slotMinutes   Int      @default(30)
  bufferMinutes Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Booking {
  id                 String        @id @default(cuid())
  applicationId      String
  application        Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  startsAt           DateTime
  endsAt             DateTime
  status             BookingStatus @default(confirmed)
  meetingUrl         String?
  microsoftEventId   String?
  cancelToken        String        @unique
  confirmedStartsAt  DateTime?     @unique
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([applicationId])
  @@index([startsAt, status])
}

enum JobSourceType {
  greenhouse
  lever
  ashby
  jsonld
  custom
}

enum JobSyncStatus {
  running
  success
  partial
  failed
}

model JobSource {
  id                    String        @id @default(cuid())
  companyName           String
  companySlug           String        @unique
  companyLogoUrl        String?
  sourceType            JobSourceType
  boardToken            String        @default("")
  careersUrl            String        @default("")
  enabled               Boolean       @default(true)
  priority              Int           @default(100)
  crawlFrequencyMinutes Int           @default(360)
  lastCrawledAt         DateTime?
  lastSuccessAt         DateTime?
  lastError             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  jobs                  Job[]
  syncRuns              JobSyncRun[]

  @@index([enabled, priority])
  @@index([sourceType])
}

model Job {
  id               String     @id @default(cuid())
  sourceId         String
  source           JobSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalJobId    String
  slug             String     @unique
  title            String
  companyName      String
  companyLogoUrl   String?
  descriptionHtml  String     @default("")
  descriptionText  String     @default("")
  location         String?
  country          String?
  state            String?
  city             String?
  remoteType       String?
  employmentType   String?
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?
  experienceLevel  String?
  category         String?
  relevanceScore   Int        @default(0)
  postedAt         DateTime?
  updatedAtSource  DateTime?
  expiresAt        DateTime?
  applyUrl         String
  sourceUrl        String
  fingerprint      String
  isActive         Boolean    @default(true)
  isDuplicate      Boolean    @default(false)
  firstSeenAt      DateTime   @default(now())
  lastSeenAt       DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([sourceId, externalJobId])
  @@index([isActive])
  @@index([postedAt])
  @@index([relevanceScore])
  @@index([companyName])
  @@index([category])
  @@index([remoteType])
  @@index([fingerprint])
  @@index([isActive, isDuplicate, relevanceScore, postedAt])
  @@index([slug])
}

model JobSyncRun {
  id           String        @id @default(cuid())
  sourceId     String
  source       JobSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  status       JobSyncStatus @default(running)
  jobsFetched  Int           @default(0)
  jobsInserted Int           @default(0)
  jobsUpdated  Int           @default(0)
  jobsRejected Int           @default(0)
  errorMessage String?
  createdAt    DateTime      @default(now())

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
}

model JobSyncLock {
  id          String    @id
  owner       String?
  lockedAt    DateTime?
  lockedUntil DateTime?
}
